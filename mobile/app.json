{
  "expo": {
    "name": "ParkEasy",
    "slug": "parkeasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkeasy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ParkEasy requires camera access to scan parking ticket QR codes and user profile QR codes.",
        "NSLocationWhenInUseUsageDescription": "ParkEasy requires location access to find nearby parking sites and calculate distance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.parkeasy.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ParkEasy to use your camera to scan ticket and wallet QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ParkEasy to use your location to search for nearby parking spaces."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E4FD8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "28f314ed-4288-4018-bb31-4bac48383d98"
      }
    },
    "owner": "bharathan014"
  }
}
