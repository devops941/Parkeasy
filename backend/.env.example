NODE_ENV=development
PORT=5000

# MongoDB Atlas Replica Set Connection String (required for transactions)
# e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/parkeasy?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/parkeasy?replicaSet=rs0

# JWT Secrets
JWT_ACCESS_SECRET=parkeasy_super_secret_access_jwt_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=parkeasy_super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=7d
JWT_QR_SECRET=parkeasy_qr_signing_secret_key_2026

# Client / CORS
CORS_ORIGIN=*

# Razorpay Test Credentials (for Phase 4)
RAZORPAY_KEY_ID=rzp_test_samplekey123
RAZORPAY_KEY_SECRET=sample_secret_key_456

